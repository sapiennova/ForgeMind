# Copy to your deployment environment. Never commit real credentials.
FORGEMIND_ENV=development
# Generate a unique high-entropy value (at least 32 bytes) for every deployment.
FORGEMIND_API_KEY=
# Comma-separated exact hostnames. Configure actual production DNS names.
FORGEMIND_ALLOWED_HOSTS=localhost,127.0.0.1
# Exact browser origins only. Leave empty for a backend without browser clients.
FORGEMIND_CORS_ORIGINS=
FORGEMIND_MAX_REQUEST_BYTES=1048576
# Interactive API docs are available only outside production.
FORGEMIND_DOCS_ENABLED=true

# Configure DATABASE_URL separately when database-backed endpoints are enabled.
